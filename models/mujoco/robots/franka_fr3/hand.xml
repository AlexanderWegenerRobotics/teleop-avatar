<mujoco model="panda hand">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
      <default class="finger">
        <!-- damping=700 is the finger SPEED LIMIT, not a stability hack: the
             actuator below saturates at 70 N on the tendon (35 N per finger),
             so terminal finger speed is 35/700 = 0.05 m/s, i.e. ~0.1 m/s width
             speed -- the same 0.1 m/s ArmControl::applyGripper asks the real
             hand for. Without it a 30 kN/m servo slams the fingers shut at
             >1 m/s. Joint damping is integrated implicitly (implicitfast), so
             this value is unconditionally stable at dt = 1 ms. -->
        <joint axis="0 1 0" type="slide" range="0.003 0.04" damping="700"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <!-- Fingertip pads: these five geoms are the grasp. Without explicit
             solref/solimp they ran at MuJoCo's default 20 ms time constant,
             ten times softer than the board/peg contacts, and the part sat on
             mushy springs in the fingers (1.3 mm of pad penetration per side
             on a 37 mm bar). priority="1" makes the pad parameters win over
             whatever the grasped object declares, so every object is held the
             same way regardless of how its own XML was tuned.
             solref dampratio 2 (not 1): at dampratio 1 the normal contact
             micro-bounces and the part ratchets along the pads under a
             sustained tangential load (4.5 mm/s at 20 N, measured). At 2 the
             creep is 0.09 mm/s at 20 N. timeconst 0.002 is the floor at
             dt = 1 ms. Needs option impratio="10" (set in SceneBuilder):
             at impratio 1 the creep is 10x higher. -->
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445" friction="1.3 0.05 0.01" condim="6" margin="0.0004" solref="0.002 2" solimp="0.995 0.995 0.0002" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.005 0.05" friction="1.3 0.05 0.01" condim="6" margin="0.0004" solref="0.002 2" solimp="0.995 0.995 0.0002" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.005 0.05" friction="1.3 0.05 0.01" condim="6" margin="0.0004" solref="0.002 2" solimp="0.995 0.995 0.0002" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.005 0.0395" friction="1.3 0.05 0.01" condim="6" margin="0.0004" solref="0.002 2" solimp="0.995 0.995 0.0002" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.005 0.0395" friction="1.3 0.05 0.01" condim="6" margin="0.0004" solref="0.002 2" solimp="0.995 0.995 0.0002" priority="1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material class="panda" name="white" rgba="1 1 1 1"/>
    <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
    <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>

    <!-- Collision meshes -->
    <mesh name="hand_c" file="hand.stl"/>

    <!-- Visual meshes -->
    <mesh file="hand_0.obj"/>
    <mesh file="hand_1.obj"/>
    <mesh file="hand_2.obj"/>
    <mesh file="hand_3.obj"/>
    <mesh file="hand_4.obj"/>
    <mesh file="finger_0.obj"/>
    <mesh file="finger_1.obj"/>
  </asset>

  <worldbody>
    <body name="hand" childclass="panda" quat="0 0 0 1">
      <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
      <geom mesh="hand_0" material="off_white" class="visual"/>
      <geom mesh="hand_1" material="black" class="visual"/>
      <geom mesh="hand_2" material="black" class="visual"/>
      <geom mesh="hand_3" material="white" class="visual"/>
      <geom mesh="hand_4" material="off_white" class="visual"/>
      <geom mesh="hand_c" class="collision"/>
      <body name="left_finger" pos="0 0 0.0584">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <joint name="finger_joint1" class="finger"/>
        <geom mesh="finger_0" material="off_white" class="visual"/>
        <geom mesh="finger_1" material="black" class="visual"/>
        <geom mesh="finger_0" class="collision"/>
        <geom class="fingertip_pad_collision_1"/>
        <geom class="fingertip_pad_collision_2"/>
        <geom class="fingertip_pad_collision_3"/>
        <geom class="fingertip_pad_collision_4"/>
        <geom class="fingertip_pad_collision_5"/>
      </body>
      <body name="right_finger" pos="0 0 0.0584" quat="0 0 0 1">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <joint name="finger_joint2" class="finger"/>
        <geom mesh="finger_0" material="off_white" class="visual"/>
        <geom mesh="finger_1" material="black" class="visual"/>
        <geom mesh="finger_0" class="collision"/>
        <geom class="fingertip_pad_collision_1"/>
        <geom class="fingertip_pad_collision_2"/>
        <geom class="fingertip_pad_collision_3"/>
        <geom class="fingertip_pad_collision_4"/>
        <geom class="fingertip_pad_collision_5"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="hand" body2="left_finger"/>
    <exclude body1="hand" body2="right_finger"/>
    <exclude body1="left_finger" body2="right_finger"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5"/>
      <joint joint="finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <!-- Finger coupling. The tendon actuator only controls the SUM of the two
         finger positions; a lateral load on the grasped object shifts both
         fingers the same way and the actuator never sees it. This equality is
         what resists that, so it has to be as stiff as the contacts. At the
         old solref 0.005 it was a soft spring (the object slid sideways in the
         hand); at 0.002 (floor at dt = 1 ms) a 20 N lateral load moves the
         object 0.04 mm. On the real hand the fingers are locked together by
         the lead screw. -->
    <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.99 0.99 0.001" solref="0.002 1"/>
  </equality>

  <actuator>
    <!-- Finger servo, modelled after the real Franka Hand: a lead-screw drive
         that is effectively rigid in position and limited in force. Affine
         actuator: force = gain*ctrl + biasprm[1]*length + biasprm[2]*velocity,
         with length = tendon "split" = half the gripper width.

           kp = 30 000 N/m on the half-width (was 1 000; Menagerie ships 100).
                A 1 kN/m servo opened 1 cm under 5 N -- that was the "spring".
           gain = kp * 0.04 / 255 = 4.70588, so ctrl in (0, 255) still maps to
                half-width in (0, 0.04) exactly as Simulation::setGripper
                assumes. Do not change one without the other.
           kd = 100 N s/m: light, the speed limit lives in the finger joint
                damping (see class "finger").
           forcerange +-70 N on the tendon = 35 N per finger, the hand's
                continuous grasp-force rating. Behaviour is "rigid until 70 N,
                then yield", which is what the real hand does.

         Measured (standalone, 37 mm / 0.27 kg bar, dt 1 ms): 20 N in any
         direction moves the bar < 0.2 mm; 1 N m twist rotates it 0.5 deg;
         10 s off-centre hold drifts 0.1 mm; closes 80 -> 37 mm in 0.43 s.
         Stability: effective mass on the tendon is 2*(0.015+0.1 armature) =
         0.23 kg, omega = sqrt(30000/0.23) = 360 rad/s, omega*dt = 0.36. -->
    <general class="panda" name="actuator8" tendon="split" forcerange="-70 70" ctrlrange="0 255"
      gainprm="4.70588 0 0" biasprm="0 -30000 -100"/>
  </actuator>
</mujoco>
