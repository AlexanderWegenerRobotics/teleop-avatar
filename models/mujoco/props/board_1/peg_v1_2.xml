<mujoco model="peg_v1_2">
  <!-- FMB board 1 - cradle, right side slot.  Per-side clearance 1.00 mm (FMB default is 2.00).
       Geometry is generated, not hand-written: every lateral dimension is derived
       from the board feature it mates with, minus 2 x clearance. All z dimensions
       are identical to FMB default, so the seated height is unchanged.
       The visual geoms are the collision boxes themselves - for these rectilinear
       parts that is exact, and it means visual and collision can never disagree. -->

  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>

  <default>
    <default class="peg_v1_2">
      <default class="vis">
        <geom contype="0" conaffinity="0" group="2" density="0" material="peg_v1_2_mat"/>
      </default>
      <default class="col">
        <geom contype="1" conaffinity="1" group="3" priority="0"
              friction="0.3 0.02 0.001" solref="0.002 1" solimp="0.995 0.995 0.0001"
              condim="6" rgba="0.1 0.1 0.5 0.5"/>
      </default>
    </default>
  </default>

  <asset><material name="peg_v1_2_mat" rgba="0.1 0.1 0.5 1.0"/></asset>

  <worldbody>
    <body name="peg_v1_2" pos="0 0 0" childclass="peg_v1_2">
      <freejoint name="peg_v1_2_joint"/>
      <geom name="peg_v1_2_vis_base" type="box" class="vis" pos="0.000000 0.000000 0.017500" size="0.016000 0.051000 0.017500"/>
      <geom name="peg_v1_2_vis_upright_neg" type="box" class="vis" pos="0.000000 -0.035125 0.067500" size="0.016000 0.015875 0.032500"/>
      <geom name="peg_v1_2_vis_upright_pos" type="box" class="vis" pos="0.000000 0.035125 0.067500" size="0.016000 0.015875 0.032500"/>
      <geom name="peg_v1_2_col_base" type="box" class="col" pos="0.000000 0.000000 0.017500" size="0.016000 0.051000 0.017500"/>
      <geom name="peg_v1_2_col_upright_neg" type="box" class="col" pos="0.000000 -0.035125 0.067500" size="0.016000 0.015875 0.032500"/>
      <geom name="peg_v1_2_col_upright_pos" type="box" class="col" pos="0.000000 0.035125 0.067500" size="0.016000 0.015875 0.032500"/>
    </body>
  </worldbody>
</mujoco>
