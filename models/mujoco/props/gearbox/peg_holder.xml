  <worldbody>
    <body name="peg_holder">
      <freejoint name="peg_holder_joint"/>
      <geom name="peg_holder" mesh="peg_holder" type="mesh" material="metal_mat"
            condim="6" friction="0.6 0.005 0.0001"
            solimp="0.99 0.99 0.001" solref="0.01 1"/>
    </body>
  </worldbody>
</mujoco>
