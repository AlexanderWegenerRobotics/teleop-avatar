  <asset>
    <mesh name="peg_holder" file="peg_holder_real.stl" scale="1 1 1"/>
    <material name="metal_mat" rgba="0.55 0.55 0.60 1"
              specular="0.8" shininess="0.5" reflectance="0.3"/>
