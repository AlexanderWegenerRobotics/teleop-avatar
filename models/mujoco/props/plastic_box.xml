<mujoco model="plastic_box">
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <material name="plastic_mat"
              rgba="0.75 0.78 0.80 0.45"
              specular="0.6"
              shininess="0.4"
              reflectance="0.15"/>
  </asset>

  <default>
    <default class="box_wall">
      <geom material="plastic_mat" condim="6"
            friction="0.6 0.005 0.0001"
            solimp="0.99 0.99 0.001" solref="0.01 1"/>
    </default>
  </default>

  <worldbody>
    <body name="plastic_box">
      <!-- <freejoint name="box_joint"/> -->
      <inertial mass="0.35" pos="0 0 0.0725" diaginertia="8e-4 1.2e-3 1.4e-3"/>

      <!-- Inner cavity: 240 x 200 x 145mm. Wall thickness: 4mm. -->

      <!-- Floor -->
      <geom name="floor" class="box_wall" type="box"
            size="0.120 0.100 0.004" pos="0 0 -0.004"/>

      <!-- Front wall -->
      <geom name="wall_front" class="box_wall" type="box"
            size="0.004 0.100 0.0725" pos="0.120 0 0.0725"/>

      <!-- Back wall -->
      <geom name="wall_back" class="box_wall" type="box"
            size="0.004 0.100 0.0725" pos="-0.120 0 0.0725"/>

      <!-- Left wall -->
      <geom name="wall_left" class="box_wall" type="box"
            size="0.124 0.004 0.0725" pos="0 0.100 0.0725"/>

      <!-- Right wall -->
      <geom name="wall_right" class="box_wall" type="box"
            size="0.124 0.004 0.0725" pos="0 -0.100 0.0725"/>

    </body>
  </worldbody>
</mujoco>